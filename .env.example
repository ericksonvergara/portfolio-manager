POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio

SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/portfolio
SPRING_DATASOURCE_USERNAME=portfolio
SPRING_DATASOURCE_PASSWORD=portfolio
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT - generate a secret with: openssl rand -base64 48
JWT_SECRET=change-me-with-a-random-secret-of-at-least-32-bytes
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Initial administrator (created on first start-up only).
# Password rules: 6-12 chars, uppercase, lowercase, digit and special character.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change#Me1

# OpenAPI / Swagger UI at /api/docs/swagger-ui.html (set to false to hide it in production)
API_DOCS_ENABLED=true

# Local development only: also loads demo content (profile, technologies) from db/seed.
# Never set it in production. Once a database has the demo data, keep the seed location for it:
# Flyway rejects a database whose applied migrations are not all in the configured locations.
SPRING_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# Maximum size of an uploaded image (HU019). Formats: JPG, JPEG and PNG.
UPLOAD_MAX_SIZE=5MB

# Email (password recovery, HU010). By default the backend sends to the local Mailpit container
# (inbox at http://localhost:8025) and nothing is delivered. For a real SMTP server set, for example:
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=...
# MAIL_PASSWORD=...
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
MAIL_FROM="Portfolio Manager <no-reply@portfolio.local>"

# Page of the frontend that the recovery link opens, and how long the link is valid
PASSWORD_RESET_URL=http://localhost:8081/restablecer-contrasena
PASSWORD_RESET_TTL=30m

# Contact form (HU006): messages one visitor (IP) may send per window, against spam.
# The notice goes to the contact email of the profile, from MAIL_FROM.
CONTACT_MAX_MESSAGES=5
CONTACT_WINDOW=1h
